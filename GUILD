        <div class="forum-post">
            <a href="#" class="post-title">🎮 Introduce Yourself — Say Hello!</a>
            <div class="post-meta">Posted by: Member • 18 Sep 2026 — 24 replies</div>
        </div>
    </div>
</div>

<!-- GALLERY PAGE -->
<div class="page" id="page-gallery">
    <h2 class="page-title">🖼️ Gallery</h2>
    <p style="margin-bottom: 1.5rem; color:#aaa;">Coming soon — guild screenshots, raid moments, and memories from WoW Forever!</p>
    
    <div class="gallery-grid">
        <div class="gallery-card">
            <div class="gallery-img">⚔️</div>
            <div class="gallery-caption">Guild Group Photo — Launch Day</div>
        </div>
        <div class="gallery-card">
