    <p style="margin-top: 2rem; color:#888; font-style:italic;">Upload your own screenshots to share with the guild!</p>
</div>

<!-- Footer -->
<footer>
    <p>⚔️ REBORN — Horde Guild | WoW Forever • Launching 4th November 2026</p>
    <p style="margin-top: 0.5rem;">© 2026 REBORN Guild. All rights reserved.</p>
</footer>

<script>
    // Page switching function
    function showPage(pageName) {
        // Hide all pages
        document.querySelectorAll('.page').forEach(page => {
            page.classList.remove('active');
        });
        // Remove active from all nav links
        document.querySelectorAll('.nav-links a').forEach(link => {
            link.classList.remove('active');
        });
        // Show selected page
        document.getElementById('page-' + pageName).classList.add('active');
        // Highlight active nav link
        document.getElementById('nav-' + pageName).classList.add('active');
        // Scroll to top
        window.scrollTo(0, 0);
    }
</script>

</body>
</html>
